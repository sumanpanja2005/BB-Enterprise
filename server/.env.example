NODE_ENV=development
PORT=5000
# Used for reset-password and payment redirect URLs.
FRONTEND_URL=https://your-frontend.onrender.com

MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/bb_enterprise?retryWrites=true&w=majority

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudinary — https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Gmail: use App Password) — optional; leave empty to skip sending
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="BB Enterprise <noreply@bbenterprise.com>"
